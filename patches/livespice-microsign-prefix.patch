From eee3fc10147983565db74295bc06aeb12624f979 Mon Sep 17 00:00:00 2001
From: gene <geneko@gmail.com>
Date: Wed, 8 Jul 2026 20:23:25 -0400
Subject: [PATCH] Quantity: recognize U+00B5 MICRO SIGN as micro prefix
 (vendored patch)

---
 Circuit/Utils/Quantity.cs | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/Circuit/Utils/Quantity.cs b/Circuit/Utils/Quantity.cs
index 5f5a2e0..c979fa6 100644
--- a/Circuit/Utils/Quantity.cs
+++ b/Circuit/Utils/Quantity.cs
@@ -122,7 +122,8 @@ private static string DeAliasPrefix(string Prefix)
         {
             switch (Prefix)
             {
-                case "u": return "\u03BC";
+                case "u": return "\u03BC";        // ASCII 'u'
+                case "\u00B5": return "\u03BC";   // U+00B5 MICRO SIGN (what most tools/.schx emit) -> GREEK MU
                 default: return Prefix;
             }
         }
